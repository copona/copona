# Copy to demo.env (gitignored) and fill in. Used by docker-compose.yml.

# MariaDB root password; the store connects as root inside the private
# compose network. Use a long random value: openssl rand -hex 24
MARIADB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me

# The admin account the installer creates. In demo mode it is read-only and
# these values are pre-filled on the admin login form, so keep them simple.
ADMIN_USERNAME=demo
ADMIN_PASSWORD=demo
ADMIN_EMAIL=demo@example.com
DEMO_ADMIN_USERNAME=demo
DEMO_ADMIN_PASSWORD=demo

# Shown in the demo banner: "... It resets every hour."
DEMO_RESET_INTERVAL="every hour"

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
TUNNEL_TOKEN=
